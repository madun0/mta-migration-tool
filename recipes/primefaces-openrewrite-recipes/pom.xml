<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jackson.mta</groupId>
    <artifactId>primefaces-openrewrite-recipes</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>PrimeFaces OpenRewrite Recipes</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!--
            Keep all OpenRewrite core modules on exactly the same version.
        -->
        <rewrite.version>8.90.2</rewrite.version>

        <!--
            Recipe libraries are versioned separately from Rewrite core.
        -->
        <rewrite-java-dependencies.version>1.60.2</rewrite-java-dependencies.version>

        <junit.version>5.14.0</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!--
                Manages versions for rewrite-core, rewrite-java,
                rewrite-xml, rewrite-test, rewrite-java-21, etc.
            -->
            <dependency>
                <groupId>org.openrewrite</groupId>
                <artifactId>rewrite-bom</artifactId>
                <version>${rewrite.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!--
            Core API used for Java AST traversal and transformation.
        -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java</artifactId>
        </dependency>

        <!--
            XML support. Required by recipes which modify files such as
            web.xml and faces-config.xml.
        -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-xml</artifactId>
        </dependency>

        <!--
            Maven model support used by Foundation recipes that modernize
            Jakarta API and PrimeFaces dependencies and normalize Java 21 compilation.
        -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-maven</artifactId>
        </dependency>

        <!--
            Java 21 parser implementation.

            Runtime scope is sufficient because recipe source code normally
            programs against rewrite-java rather than the parser implementation.
        -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-java-21</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Provides recipes for manipulating Maven dependencies, plugins,
            properties, and Java dependency declarations.
        -->
        <dependency>
            <groupId>org.openrewrite.recipe</groupId>
            <artifactId>rewrite-java-dependencies</artifactId>
            <version>${rewrite-java-dependencies.version}</version>
        </dependency>

        <!--
            OpenRewrite test harness used by RecipeSpec and RewriteTest.
        -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            Legacy JSF API used to type-attribute source code being migrated.
            This is intentionally a test dependency: the recipe itself does not
            ship JSF as a runtime dependency.
        -->
        <dependency>
            <groupId>javax.faces</groupId>
            <artifactId>javax.faces-api</artifactId>
            <version>2.3</version>
            <scope>test</scope>
        </dependency>

        <!--
            PrimeFaces 6.2 contains the legacy RequestContext API that these
            migration tests use as their source-side type system.
        -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>6.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

        </plugins>
    </build>

</project>